# ─── alfio-bridge ────────────────────────────────────────────
ALFIO_BRIDGE_PORT=8080
ALFIO_BRIDGE_API_KEY=change-me

# Read-only connection to the alf.io PostgreSQL database
ALFIO_DB_HOST=db-alfio
ALFIO_DB_PORT=5432
ALFIO_DB_NAME=alfio
ALFIO_DB_USER=alfio
ALFIO_DB_PASSWORD=change-me

# Optional pool tuning
ALFIO_DB_MAX_POOL_SIZE=4
ALFIO_DB_MIN_IDLE=1
